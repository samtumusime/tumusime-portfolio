# Supabase project settings (Project Settings -> API)
# Safe to expose in the browser — these are public/anon values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Stable UUID of the single Supabase Auth user allowed to use /admin.
# This is not a secret. It must match the UID bound in the approved RLS migration.
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
