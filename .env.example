# Supabase project settings (Project Settings -> API)
# Safe to expose in the browser — these are public/anon values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used exclusively in server-side code (never sent to the browser)
# for admin-only operations. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single email address allowed to sign in to /admin.
# Must match the email of the one Supabase Auth user you create for yourself.
ADMIN_EMAIL=you@example.com
